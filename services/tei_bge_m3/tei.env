# Text Embeddings Inference — BGE-M3
# Değiştirdikten sonra: ./svc restart tei

# Model ve batch ayarları
# Bu değerler docker-compose.yml'deki command argümanlarına yansır.
# Değiştirmek isterseniz docker-compose.yml'deki tei-bge-m3 → command satırlarını da güncelleyin.
#   --model-id  →  BAAI/bge-m3
#   --max-batch-tokens  →  16384
#   --max-client-batch-size  →  32

# DGX Spark: 20 çekirdek — embedding throughput için CPU thread
RAYON_NUM_THREADS=16

# Veri/cache dizini (container volume olarak bağlanır)
# Host path: /raid/monassist1/tei_data
