# Şablon — projede `medgemma.env` bu içerikle zaten var. Yeni makine: `cp medgemma.env.example medgemma.env` ve yolları düzenleyin.
# Öncelik: ortam değişkeni > medgemma.env > defaults.py

# Uzak istemci aynı API'yi kullanır: VLLM_BASE_URL=http://<sunucu-ip>:8000
VLLM_BASE_URL=http://127.0.0.1:8000
VLLM_MODEL=/raid/monassist1/medgemma_model_gptq_w4
VLLM_TIMEOUT_SECONDS=120
ANALYZE_MAX_TOKENS=900

VLLM_SERVE_HOST=0.0.0.0
VLLM_SERVE_PORT=8000
MEDGAMMA_VENV=/home/monassist1/medgamma_env

# vLLM resmi: daha iyi CUDA graph / KV tahmini için (serve script bilinmeyen VLLM_* temizliyor).
# export VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=1
#
# UMA/GPU bellek baskısı: max_model_len ve util ile sınırla; MEMORY_PROFILER=1 ise ~0.822 ≈ önceki 0.80 profilersız KV’ye denk gelebilir.
# VLLM_SERVE_EXTRA_ARGS="--max-model-len 32768 --gpu-memory-utilization 0.822"

# İsteğe bağlı: CUDA_VISIBLE_DEVICES=0
# Sadece bu makineden erişim: VLLM_SERVE_HOST=127.0.0.1
