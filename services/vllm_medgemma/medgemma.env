# Bu makine için sabit ayarlar: GPTQ MedGemma + 8000.
# Aynı isimde ortam değişkeni zaten tanımlıysa o değer kullanılır (öncelik: env > bu dosya).

# Pipeline bu makinede koşuyorsa bağlantı yine localhost kalır.
VLLM_BASE_URL=http://127.0.0.1:8000

# Uzakta koşan istemci için: http://<bu-makinenin-ip>:8000

VLLM_MODEL=/raid/monassist1/medgemma_model_gptq_w4
VLLM_TIMEOUT_SECONDS=120
ANALYZE_MAX_TOKENS=900

# 0.0.0.0 = tüm arayüzlerde dinle (LAN / dışarıdan erişim). Sadece localhost için: 127.0.0.1
VLLM_SERVE_HOST=0.0.0.0
VLLM_SERVE_PORT=8000
MEDGAMMA_VENV=/home/monassist1/medgamma_env

# GPU: prefix cache + eşzamanlı istek.
# 64K context — tüm görsellerin sınırsız gönderilmesi için gerekli.
# max-num-seqs=4 ile 64K context OOM riskini azaltır.
VLLM_SERVE_EXTRA_ARGS="--max-model-len 65536 --gpu-memory-utilization 0.80 --max-num-seqs 4 --enable-prefix-caching"
