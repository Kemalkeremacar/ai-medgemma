# Open WebUI
# Değiştirdikten sonra: ./svc restart webui

# MedGemma/vLLM bağlantısı (host.docker.internal = host makinenin IP'si)
OPENAI_API_BASE_URL=http://host.docker.internal:8000/v1
OPENAI_API_KEY=sk-no-key

ENV=prod
USE_OLLAMA_DOCKER=false
USE_CUDA_DOCKER=false

# Embedding modelleri
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AUXILIARY_EMBEDDING_MODEL=TaylorAI/bge-micro-v2

# Gizlilik
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Whisper (ses transkripsiyonu)
WHISPER_MODEL=base
