[Unit]
Description=Provizyon Orkestrator Worker
After=network-online.target redis.service
Wants=network-online.target

[Service]
Type=simple
User=monassist1
WorkingDirectory=/home/monassist1/GemmaApp/provizyon
EnvironmentFile=/home/monassist1/GemmaApp/provizyon/config/provizyon.env
ExecStart=/home/monassist1/GemmaApp/provizyon/run_worker.sh start-foreground
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
