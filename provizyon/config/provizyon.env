# Provizyon Orkestratör ortam değişkenleri.
# run_api.sh / run_worker.sh tarafından source edilir. env > bu dosya > settings.py defaults.

# --- Redis kuyruk ---
PROVIZYON_REDIS_URL=redis://127.0.0.1:6379/0
PROVIZYON_QUEUE_NAME=provizyon:jobs
PROVIZYON_MAX_RETRIES=3

# Paralel çalışacak worker sayısı (./svc start provizyon-worker bunu kullanır).
# Her worker kendi processing listesini kullanır; çift işleme olmaz.
PROVIZYON_WORKERS=1

# --- Belge kaynağı (dosya sistemi) ---
PROVIZYON_DOCUMENT_ROOT=/home/monassist1/GemmaApp/data/documents
PROVIZYON_WORK_DIR=/home/monassist1/GemmaApp/data/provizyon_work

# --- Klasör izleyici (intake watcher) ---
# Bu kök altına düşen her provizyon klasörü otomatik kuyruğa eklenir.
PROVIZYON_INTAKE_WATCH_DIR=/home/monassist1/GemmaApp/data/intake
PROVIZYON_INTAKE_POLL_SECONDS=10
PROVIZYON_INTAKE_STABLE_SECONDS=15

# --- OCR (Tesseract) ---
PROVIZYON_TESSERACT_CMD=tesseract
PROVIZYON_OCR_LANG=tur+eng
PROVIZYON_OCR_DPI=400
PROVIZYON_OCR_MIN_EDGE=2400
PROVIZYON_OCR_PSM=3
PROVIZYON_OCR_PREPROCESS=1
PROVIZYON_OCR_ALL_PAGES=1

# --- MedGemma (vision destekli; auto = görsel varsa gönder) ---
PROVIZYON_MEDGEMMA_BASE_URL=http://127.0.0.1:8000/v1
PROVIZYON_MEDGEMMA_MODEL=/raid/monassist1/medgemma_model_gptq_w4
PROVIZYON_MEDGEMMA_VISION_MODE=auto
# 0 = sınırsız; 64K context ile tüm sayfalar gönderilebilir
PROVIZYON_VISION_MAX_IMAGES=0
PROVIZYON_OCR_MIN_QUALITY=0.35
PROVIZYON_TEXT_EVIDENCE_MAX_CHARS=32000

# --- Qdrant / TEI ---
PROVIZYON_QDRANT_URL=http://127.0.0.1:6333
PROVIZYON_TEI_URL=http://127.0.0.1:8002
PROVIZYON_FINDINGS_COLLECTION=patient_findings
PROVIZYON_DIAGNOSIS_COLLECTION=huv_diagnosis_rules
PROVIZYON_SUT_DIAGNOSIS_COLLECTION=sut_diagnosis_rules
PROVIZYON_DIAGNOSIS_PROCEDURE_COLLECTION=diagnosis_procedure_pilot
PROVIZYON_ENABLE_DIAGNOSIS_PAYMENT_SIGNAL=1

# --- API ---
PROVIZYON_API_HOST=0.0.0.0
PROVIZYON_API_PORT=8020
