# MedGemma Gateway ayarları — bu dosyayı gateway.env olarak kopyalayıp doldurun.
# Öncelik: ortam değişkeni > gateway.env

# Gateway'in dinleyeceği adres/port (0.0.0.0 = ağa açık, başka makineden erişim).
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# İsimli API key dosyası (her satır: <key>:<isim>). Örnek: api_keys.txt.example
GATEWAY_API_KEYS_FILE=/home/monassist1/GemmaApp/medgemma_gateway/api_keys.txt
# Alternatif olarak tek anahtar da tanımlanabilir (isim: "default"):
# GATEWAY_API_KEY=

# Arkadaki mevcut vLLM sunucusu (bu makinede çalışıyor).
GATEWAY_UPSTREAM_URL=http://127.0.0.1:8000/v1

# İstemci model belirtmezse kullanılacak varsayılan model.
GATEWAY_DEFAULT_MODEL=/raid/monassist1/medgemma_model_gptq_w4

# İstek zaman aşımı (saniye). Uzun promptlar (5-10 dk) için 30 dk pay.
GATEWAY_TIMEOUT_SECONDS=1800

# Kuyruk: aynı anda upstream'e gidecek en fazla istek sayısı (gerisi sırada bekler).
# vLLM --max-num-seqs (4) ile uyumlu tutmak mantıklı.
GATEWAY_MAX_CONCURRENCY=4

# Bir istek kuyrukta en fazla kaç saniye beklesin (SLA ile birlikte üst sınır).
GATEWAY_QUEUE_TIMEOUT_SECONDS=1800

# --- SLA (toplam deadline) ---
# İstek gateway'e ulaştığı andan yanıta kadar toplam süre bütçesi (saniye).
# Kuyruk + upstream bu değeri aşarsa istek HTTP 504 döner ve upstream isteği
# iptal edilir (GPU slotu hemen serbest kalır). İstemci 504 gövdesinden
# {"error":"timeout","stage":"queue|upstream",...} okuyup kendi tarafında loglar.
GATEWAY_SLA_SECONDS=300

# --- İstek kaydı (log) ---
GATEWAY_LOG_REQUESTS=1
GATEWAY_LOG_FILE=/home/monassist1/GemmaApp/logs/gateway_requests.jsonl
# Prompt/cevap içeriği de yazılsın mı? 0 = sadece meta veri (tıbbi gizlilik için önerilir).
GATEWAY_LOG_CONTENT=0

# --- Rate limit ---
# Anahtar başına dakikada en fazla istek. 0 = sınırsız (kapalı).
GATEWAY_RATE_LIMIT_PER_MIN=0
