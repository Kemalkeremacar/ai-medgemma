#!/usr/bin/env bash
# GemmaApp — Unified Service Manager
# Kullanım: ./svc <komut> [servis]
# Komutlar: status, start, stop, restart, logs, config
# Servisler: medgemma, qdrant, tei, webui, redis, provizyon, all (varsayılan: all)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_FILE="$SCRIPT_DIR/docker-compose.yml"
LOG_DIR="$SCRIPT_DIR/logs"
MEDGEMMA_PID_FILE="$LOG_DIR/medgemma.pid"
MEDGEMMA_LOG_FILE="$LOG_DIR/medgemma.log"
MEDGEMMA_SERVE_SCRIPT="$SCRIPT_DIR/services/vllm_medgemma/serve_medgemma.sh"
PROV_API_RUN_SCRIPT="$SCRIPT_DIR/provizyon/run_api.sh"
PROV_WORKER_RUN_SCRIPT="$SCRIPT_DIR/provizyon/run_worker.sh"
PROV_API_PID_FILE="$LOG_DIR/provizyon-api.pid"
PROV_API_LOG_FILE="$LOG_DIR/provizyon-api.log"
PROV_WORKER_PID_FILE="$LOG_DIR/provizyon-worker.pid"
PROV_WORKER_LOG_FILE="$LOG_DIR/provizyon-worker.log"
PROV_WATCHER_RUN_SCRIPT="$SCRIPT_DIR/provizyon/run_watcher.sh"
PROV_WATCHER_PID_FILE="$LOG_DIR/provizyon-watcher.pid"
PROV_WATCHER_LOG_FILE="$LOG_DIR/provizyon-watcher.log"

DOCKER_SERVICES=(qdrant tei-bge-m3 open-webui redis)
ALL_SERVICES=(medgemma qdrant tei webui redis provizyon-api provizyon-worker provizyon-watcher)

mkdir -p "$LOG_DIR"

# ── Renk ve format ──────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'

_header() { printf "\n${BOLD}%-14s %-8s %-12s %-10s %s${NC}\n" "SERVİS" "PORT" "DURUM" "UPTIME" "DETAY"; printf '%.0s─' {1..64}; echo; }
_row()    { printf "%-14s %-8s %-12b %-10s %s\n" "$1" "$2" "$3" "$4" "$5"; }

# ── Yardımcılar ─────────────────────────────────────────────────────
_map_name() {
  case "$1" in
    medgemma|vllm)   echo "medgemma" ;;
    qdrant)          echo "qdrant" ;;
    tei|tei-bge-m3)  echo "tei" ;;
    webui|open-webui) echo "webui" ;;
    redis)           echo "redis" ;;
    provizyon-api|prov-api|provapi) echo "provizyon-api" ;;
    provizyon-worker|prov-worker|provworker) echo "provizyon-worker" ;;
    provizyon-watcher|prov-watcher|provwatcher|watcher) echo "provizyon-watcher" ;;
    provizyon|prov)  echo "provizyon" ;;
    all)             echo "all" ;;
    *) echo "Bilinmeyen servis: $1" >&2; echo "Geçerli: medgemma, qdrant, tei, webui, redis, provizyon-api, provizyon-worker, provizyon-watcher, provizyon, all" >&2; exit 1 ;;
  esac
}

_docker_container() {
  case "$1" in
    qdrant)  echo "qdrant" ;;
    tei)     echo "tei-bge-m3" ;;
    webui)   echo "open-webui" ;;
    redis)   echo "redis" ;;
  esac
}

_env_file() {
  case "$1" in
    medgemma) echo "$SCRIPT_DIR/services/vllm_medgemma/medgemma.env" ;;
    qdrant)   echo "$SCRIPT_DIR/services/qdrant/qdrant.env" ;;
    tei)      echo "$SCRIPT_DIR/services/tei_bge_m3/tei.env" ;;
    webui)    echo "$SCRIPT_DIR/services/open_webui/webui.env" ;;
    provizyon-api|provizyon-worker|provizyon-watcher|provizyon) echo "$SCRIPT_DIR/provizyon/config/provizyon.env" ;;
  esac
}

# ── Provizyon (native process) yardımcıları ─────────────────────────
_status_native() {
  local name="$1" port="$2" pid_file="$3" health_path="$4"
  local pid uptime_str api_ok
  if [[ -f "$pid_file" ]]; then
    pid=$(<"$pid_file")
    if kill -0 "$pid" 2>/dev/null; then
      uptime_str=$(_medgemma_uptime "$pid")
      if [[ -n "$health_path" ]]; then
        api_ok=$(curl -sf -o /dev/null -w "%{http_code}" "http://localhost:$port$health_path" 2>/dev/null) || api_ok="000"
        if [[ "$api_ok" == "200" ]]; then
          _row "$name" "$port" "${GREEN}çalışıyor${NC}" "$uptime_str" "pid=$pid API=OK"
        else
          _row "$name" "$port" "${YELLOW}yükleniyor${NC}" "$uptime_str" "pid=$pid API=bekleniyor"
        fi
      else
        _row "$name" "$port" "${GREEN}çalışıyor${NC}" "$uptime_str" "pid=$pid"
      fi
      return
    fi
  fi
  _row "$name" "$port" "${RED}durmuş${NC}" "-" ""
}

# ── MedGemma (native process) yardımcıları ──────────────────────────
_medgemma_pid() {
  if [[ -f "$MEDGEMMA_PID_FILE" ]]; then
    local pid
    pid=$(<"$MEDGEMMA_PID_FILE")
    if kill -0 "$pid" 2>/dev/null; then
      echo "$pid"
      return 0
    fi
  fi
  # PID dosyası yoksa veya process ölmüşse, vllm serve'i ara
  local pid
  pid=$(pgrep -f "vllm serve.*/medgemma" 2>/dev/null | head -1) || true
  if [[ -n "$pid" ]]; then
    echo "$pid" > "$MEDGEMMA_PID_FILE"
    echo "$pid"
    return 0
  fi
  return 1
}

_medgemma_uptime() {
  local pid="${1:-}"
  [[ -z "$pid" ]] && echo "-" && return
  local elapsed
  elapsed=$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ') || { echo "-"; return; }
  if (( elapsed < 60 )); then
    echo "${elapsed}s"
  elif (( elapsed < 3600 )); then
    echo "$(( elapsed / 60 ))m"
  else
    echo "$(( elapsed / 3600 ))h$(( (elapsed % 3600) / 60 ))m"
  fi
}

# ── STATUS ───────────────────────────────────────────────────────────
_status_medgemma() {
  local pid uptime_str
  if pid=$(_medgemma_pid); then
    uptime_str=$(_medgemma_uptime "$pid")
    local api_ok
    api_ok=$(curl -sf -o /dev/null -w "%{http_code}" http://localhost:8000/v1/models 2>/dev/null) || api_ok="000"
    if [[ "$api_ok" == "200" ]]; then
      _row "medgemma" "8000" "${GREEN}çalışıyor${NC}" "$uptime_str" "pid=$pid API=OK"
    else
      _row "medgemma" "8000" "${YELLOW}yükleniyor${NC}" "$uptime_str" "pid=$pid API=bekleniyor"
    fi
  else
    _row "medgemma" "8000" "${RED}durmuş${NC}" "-" ""
  fi
}

_status_docker() {
  local svc_name="$1" container port
  container=$(_docker_container "$svc_name")
  case "$svc_name" in
    qdrant) port="6333" ;;
    tei)    port="8002" ;;
    webui)  port="3000" ;;
    redis)  port="6379" ;;
  esac
  local state uptime_str detail
  state=$(docker inspect -f '{{.State.Status}}' "$container" 2>/dev/null) || state="yok"
  if [[ "$state" == "running" ]]; then
    uptime_str=$(docker inspect -f '{{.State.StartedAt}}' "$container" 2>/dev/null) || uptime_str=""
    if [[ -n "$uptime_str" ]]; then
      local started_epoch now_epoch elapsed
      started_epoch=$(date -d "$uptime_str" +%s 2>/dev/null) || started_epoch=0
      now_epoch=$(date +%s)
      elapsed=$(( now_epoch - started_epoch ))
      if (( elapsed < 60 )); then uptime_str="${elapsed}s"
      elif (( elapsed < 3600 )); then uptime_str="$(( elapsed / 60 ))m"
      else uptime_str="$(( elapsed / 3600 ))h$(( (elapsed % 3600) / 60 ))m"; fi
    fi
    local health
    health=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}no-hc{{end}}' "$container" 2>/dev/null) || health=""
    _row "$svc_name" "$port" "${GREEN}çalışıyor${NC}" "$uptime_str" "container=$container health=$health"
  else
    _row "$svc_name" "$port" "${RED}$state${NC}" "-" "container=$container"
  fi
}

_status_prov_worker() {
  local running=0 pids=""
  shopt -s nullglob
  for pf in "$LOG_DIR"/provizyon-worker-*.pid; do
    local p; p=$(<"$pf")
    if kill -0 "$p" 2>/dev/null; then running=$((running+1)); pids="$pids $p"; fi
  done
  shopt -u nullglob
  if [[ "$running" -gt 0 ]]; then
    _row "provizyon-worker" "-" "${GREEN}çalışıyor${NC}" "-" "${running} worker pid:${pids# }"
  else
    _row "provizyon-worker" "-" "${RED}durmuş${NC}" "-" ""
  fi
}

cmd_status() {
  local target="${1:-all}"
  _header
  if [[ "$target" == "all" || "$target" == "medgemma" ]]; then _status_medgemma; fi
  if [[ "$target" == "all" || "$target" == "qdrant" ]]; then _status_docker qdrant; fi
  if [[ "$target" == "all" || "$target" == "tei" ]]; then _status_docker tei; fi
  if [[ "$target" == "all" || "$target" == "webui" ]]; then _status_docker webui; fi
  if [[ "$target" == "all" || "$target" == "redis" ]]; then _status_docker redis; fi
  if [[ "$target" == "all" || "$target" == "provizyon" || "$target" == "provizyon-api" ]]; then
    _status_native "provizyon-api" "8020" "$PROV_API_PID_FILE" "/health"
  fi
  if [[ "$target" == "all" || "$target" == "provizyon" || "$target" == "provizyon-worker" ]]; then
    _status_prov_worker
  fi
  if [[ "$target" == "all" || "$target" == "provizyon" || "$target" == "provizyon-watcher" ]]; then
    _status_native "provizyon-watcher" "-" "$PROV_WATCHER_PID_FILE" ""
  fi
  echo
}

# ── START ────────────────────────────────────────────────────────────
_start_medgemma() {
  if _medgemma_pid &>/dev/null; then
    echo "medgemma zaten çalışıyor (pid=$(_medgemma_pid))"
    return 0
  fi
  echo "medgemma başlatılıyor..."
  nohup bash "$MEDGEMMA_SERVE_SCRIPT" >> "$MEDGEMMA_LOG_FILE" 2>&1 &
  local bg_pid=$!
  echo "$bg_pid" > "$MEDGEMMA_PID_FILE"
  echo "medgemma başlatıldı (pid=$bg_pid, log=$MEDGEMMA_LOG_FILE)"
  echo "Model yüklenmesi 2-3 dakika sürebilir. Takip: ./svc logs medgemma"
}

_start_docker() {
  local svc_name="$1" container
  container=$(_docker_container "$svc_name")
  echo "$svc_name ($container) başlatılıyor..."
  docker compose -f "$COMPOSE_FILE" up -d "$container"
}

_start_prov_api() {
  echo "provizyon-api başlatılıyor..."
  bash "$PROV_API_RUN_SCRIPT" start
}

_start_prov_worker() {
  # PROVIZYON_WORKERS ile çoklu worker (varsayılan 1). config/provizyon.env'den okunur.
  local prov_env="$SCRIPT_DIR/provizyon/config/provizyon.env"
  local n="${PROVIZYON_WORKERS:-}"
  if [[ -z "$n" && -f "$prov_env" ]]; then
    n="$(grep -E '^PROVIZYON_WORKERS=' "$prov_env" 2>/dev/null | tail -1 | cut -d= -f2 | tr -d ' \"')"
  fi
  [[ -z "$n" ]] && n="1"
  echo "provizyon-worker başlatılıyor (${n} worker)..."
  bash "$PROV_WORKER_RUN_SCRIPT" scale "$n"
}

_stop_prov_api() {
  [[ -x "$PROV_API_RUN_SCRIPT" ]] && { echo "provizyon-api durduruluyor..."; bash "$PROV_API_RUN_SCRIPT" stop; }
}

_stop_prov_worker() {
  [[ -x "$PROV_WORKER_RUN_SCRIPT" ]] && { echo "provizyon-worker durduruluyor..."; bash "$PROV_WORKER_RUN_SCRIPT" stop all; }
}

_start_prov_watcher() {
  echo "provizyon-watcher başlatılıyor..."
  bash "$PROV_WATCHER_RUN_SCRIPT" start
}

_stop_prov_watcher() {
  [[ -x "$PROV_WATCHER_RUN_SCRIPT" ]] && { echo "provizyon-watcher durduruluyor..."; bash "$PROV_WATCHER_RUN_SCRIPT" stop; }
}

# MedGemma model yüklenene kadar bekle (TEI ile bellek çakışmasını önler).
_wait_medgemma_ready() {
  local max_wait="${1:-240}" interval=5 elapsed=0
  echo "medgemma API hazır olana kadar bekleniyor (en fazla ${max_wait}s)..."
  while (( elapsed < max_wait )); do
    if curl -sf -o /dev/null -m 3 http://localhost:8000/v1/models 2>/dev/null; then
      echo "medgemma API hazır (${elapsed}s)."
      return 0
    fi
    if ! _medgemma_pid &>/dev/null; then
      echo "medgemma process çöktü. Log: $MEDGEMMA_LOG_FILE" >&2
      return 1
    fi
    sleep "$interval"
    elapsed=$(( elapsed + interval ))
  done
  echo "medgemma API zaman aşımı (${max_wait}s)." >&2
  return 1
}

# Güvenli başlatma sırası: medgemma → bekle → qdrant/webui → tei → provizyon
_start_all_ordered() {
  _start_medgemma
  echo
  if ! _wait_medgemma_ready 240; then
    echo "UYARI: medgemma hazır değil; diğer servisler yine de başlatılıyor." >&2
  fi
  echo
  echo "qdrant, webui ve redis başlatılıyor..."
  docker compose -f "$COMPOSE_FILE" up -d qdrant open-webui redis
  echo
  echo "tei başlatılıyor..."
  docker compose -f "$COMPOSE_FILE" up -d tei-bge-m3
  echo
  _start_prov_api
  echo
  _start_prov_worker
  echo
  _start_prov_watcher
}

cmd_start() {
  local target="${1:-all}"
  if [[ "$target" == "all" ]]; then
    _start_all_ordered
  elif [[ "$target" == "medgemma" ]]; then
    _start_medgemma
  elif [[ "$target" == "provizyon-api" ]]; then
    _start_prov_api
  elif [[ "$target" == "provizyon-worker" ]]; then
    _start_prov_worker
  elif [[ "$target" == "provizyon-watcher" ]]; then
    _start_prov_watcher
  elif [[ "$target" == "provizyon" ]]; then
    _start_prov_api
    _start_prov_worker
    _start_prov_watcher
  else
    _start_docker "$target"
  fi
}

# ── STOP ─────────────────────────────────────────────────────────────
_stop_medgemma() {
  local pid
  if pid=$(_medgemma_pid); then
    echo "medgemma durduruluyor (pid=$pid)..."
    kill "$pid" 2>/dev/null || true
    local i=0
    while kill -0 "$pid" 2>/dev/null && (( i < 15 )); do
      sleep 1; ((i++))
    done
    if kill -0 "$pid" 2>/dev/null; then
      echo "Nazik kapatma başarısız, SIGKILL gönderiliyor..."
      kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$MEDGEMMA_PID_FILE"
    echo "medgemma durduruldu."
  else
    echo "medgemma zaten durmuş."
  fi
}

_stop_docker() {
  local svc_name="$1" container
  container=$(_docker_container "$svc_name")
  echo "$svc_name ($container) durduruluyor..."
  docker compose -f "$COMPOSE_FILE" stop "$container"
}

cmd_stop() {
  local target="${1:-all}"
  if [[ "$target" == "all" ]]; then
    _stop_prov_watcher
    _stop_prov_worker
    _stop_prov_api
    _stop_medgemma
    echo
    echo "Docker servisleri durduruluyor..."
    docker compose -f "$COMPOSE_FILE" stop
  elif [[ "$target" == "medgemma" ]]; then
    _stop_medgemma
  elif [[ "$target" == "provizyon-api" ]]; then
    _stop_prov_api
  elif [[ "$target" == "provizyon-worker" ]]; then
    _stop_prov_worker
  elif [[ "$target" == "provizyon-watcher" ]]; then
    _stop_prov_watcher
  elif [[ "$target" == "provizyon" ]]; then
    _stop_prov_watcher
    _stop_prov_worker
    _stop_prov_api
  else
    _stop_docker "$target"
  fi
}

# ── RESTART ──────────────────────────────────────────────────────────
cmd_restart() {
  local target="${1:-all}"
  if [[ "$target" == "all" ]]; then
    cmd_stop all
    echo
    _start_all_ordered
  elif [[ "$target" == "medgemma" ]]; then
    _stop_medgemma
    _start_medgemma
  elif [[ "$target" == "provizyon-api" ]]; then
    _stop_prov_api; sleep 1; _start_prov_api
  elif [[ "$target" == "provizyon-worker" ]]; then
    _stop_prov_worker; sleep 1; _start_prov_worker
  elif [[ "$target" == "provizyon-watcher" ]]; then
    _stop_prov_watcher; sleep 1; _start_prov_watcher
  elif [[ "$target" == "provizyon" ]]; then
    _stop_prov_watcher; _stop_prov_worker; _stop_prov_api; sleep 1; _start_prov_api; _start_prov_worker; _start_prov_watcher
  else
    local container
    container=$(_docker_container "$target")
    echo "$target ($container) yeniden başlatılıyor..."
    docker compose -f "$COMPOSE_FILE" restart "$container"
  fi
}

# ── LOGS ─────────────────────────────────────────────────────────────
cmd_logs() {
  local target="${1:-all}" lines="${LINES:-80}"
  if [[ "$target" == "provizyon-api" ]]; then
    if [[ -f "$PROV_API_LOG_FILE" ]]; then
      echo "─── provizyon-api log (son $lines satır) ───"
      tail -n "$lines" "$PROV_API_LOG_FILE"
    else
      echo "provizyon-api log dosyası yok: $PROV_API_LOG_FILE"
    fi
  elif [[ "$target" == "provizyon-worker" || "$target" == "provizyon" ]]; then
    shopt -s nullglob
    local wlogs=("$LOG_DIR"/provizyon-worker-*.log)
    shopt -u nullglob
    if [[ "${#wlogs[@]}" -gt 0 ]]; then
      for wl in "${wlogs[@]}"; do
        echo "─── $(basename "$wl") (son $lines satır) ───"
        tail -n "$lines" "$wl"
        echo
      done
    elif [[ -f "$PROV_WORKER_LOG_FILE" ]]; then
      echo "─── provizyon-worker log (son $lines satır) ───"
      tail -n "$lines" "$PROV_WORKER_LOG_FILE"
    else
      echo "provizyon-worker log dosyası yok: $LOG_DIR/provizyon-worker-*.log"
    fi
  elif [[ "$target" == "provizyon-watcher" ]]; then
    if [[ -f "$PROV_WATCHER_LOG_FILE" ]]; then
      echo "─── provizyon-watcher log (son $lines satır) ───"
      tail -n "$lines" "$PROV_WATCHER_LOG_FILE"
    else
      echo "provizyon-watcher log dosyası yok: $PROV_WATCHER_LOG_FILE"
    fi
  elif [[ "$target" == "medgemma" ]]; then
    if [[ -f "$MEDGEMMA_LOG_FILE" ]]; then
      echo "─── medgemma log (son $lines satır) ───"
      tail -n "$lines" "$MEDGEMMA_LOG_FILE"
    elif _medgemma_pid &>/dev/null; then
      echo "medgemma çalışıyor ama log dosyası yok (svc dışından başlatılmış olabilir)."
      echo "Sonraki başlatmada ./svc start medgemma ile başlatın — loglar $MEDGEMMA_LOG_FILE'a yazılacak."
      echo
      echo "─── vLLM process bilgisi ───"
      local pid; pid=$(_medgemma_pid)
      ps -p "$pid" -o pid,etime,args --no-headers 2>/dev/null || true
    else
      echo "medgemma durmuş ve log dosyası yok."
      echo "Başlatmak için: ./svc start medgemma"
    fi
  elif [[ "$target" == "all" ]]; then
    if [[ -f "$MEDGEMMA_LOG_FILE" ]]; then
      echo "─── medgemma log (son 20 satır) ───"
      tail -n 20 "$MEDGEMMA_LOG_FILE"
      echo
    fi
    echo "─── Docker logları (son 20 satır) ───"
    for c in "${DOCKER_SERVICES[@]}"; do
      echo "── $c ──"
      docker logs --tail 20 "$c" 2>&1 || true
      echo
    done
  else
    local container
    container=$(_docker_container "$target")
    docker logs --tail "$lines" -f "$container"
  fi
}

# ── CONFIG ───────────────────────────────────────────────────────────
cmd_config() {
  local target="${1:-all}"
  if [[ "$target" == "all" ]]; then
    for s in "${ALL_SERVICES[@]}"; do
      local ef
      ef=$(_env_file "$s")
      echo "═══ $s ($ef) ═══"
      cat "$ef"
      echo
    done
  else
    local ef
    ef=$(_env_file "$target")
    echo "═══ $target ($ef) ═══"
    cat "$ef"
  fi
}

# ── ANA GİRİŞ ───────────────────────────────────────────────────────
usage() {
  cat <<'EOF'
GemmaApp — Unified Service Manager

Kullanım: ./svc <komut> [servis]

Komutlar:
  status   Servislerin durumunu göster
  start    Başlat (tümü veya tek)
  stop     Durdur (tümü veya tek)
  restart  Yeniden başlat
  logs     Logları göster
  config   Konfigürasyon dosyasını göster

Servisler:
  medgemma   MedGemma / vLLM   (port 8000)
  qdrant     Qdrant VectorDB   (port 6333/6334)
  tei        TEI BGE-M3        (port 8002)
  webui      Open WebUI        (port 3000)
  redis      Redis kuyruk      (port 6379)
  provizyon-api     Provizyon API + Dashboard (port 8020)
  provizyon-worker  Provizyon Orkestratör Worker
  provizyon-watcher Provizyon Klasör İzleyici (otomatik intake)
  provizyon  Provizyon API + Worker + Watcher (hepsi)
  all        Tüm servisler     (varsayılan)

Örnekler:
  ./svc status
  ./svc start medgemma
  ./svc restart qdrant
  ./svc logs tei
  ./svc logs provizyon-worker
  ./svc config provizyon-api
EOF
}

CMD="${1:-}"
SVC_RAW="${2:-all}"

if [[ -z "$CMD" ]]; then
  usage
  exit 0
fi

SVC=$(_map_name "$SVC_RAW")

case "$CMD" in
  status)  cmd_status "$SVC" ;;
  start)   cmd_start "$SVC" ;;
  stop)    cmd_stop "$SVC" ;;
  restart) cmd_restart "$SVC" ;;
  logs)    cmd_logs "$SVC" ;;
  config)  cmd_config "$SVC" ;;
  help|-h|--help) usage ;;
  *) echo "Bilinmeyen komut: $CMD" >&2; usage; exit 1 ;;
esac
